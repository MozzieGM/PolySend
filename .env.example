# Copy this file to .env and fill in your own keys.

# OpenCode Go — generate email drafts
OPENCODE_API_KEY=oc_sk_your_key_here

# Resend — send real emails (the Delivery panel can also validate and save it here)
RESEND_API_KEY=
# Optional defaults after verifying a domain in Resend
RESEND_FROM_NAME=PolySend
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
# App-side sends per session/IP per hour
RESEND_SEND_LIMIT_PER_HOUR=20

# WhatsApp (Baileys) — set to 1 to open the studio with demo chats, no QR scan
WHATSAPP_MOCK=0

PORT=8787
