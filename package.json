{
  "name": "polysend-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PolySend — live email and WhatsApp studio powered by the OpenCode Go API",
  "author": "Gabriel Martinez de Souza (MozzieGM) — https://github.com/MozzieGM",
  "homepage": "https://github.com/MozzieGM/PolySend",
  "repository": {
    "type": "git",
    "url": "https://github.com/MozzieGM/PolySend.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.mjs",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.22",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
